    "expected_steps": "1..25 متسلسلة بلا تكرار",
    "steps": [
      {
        "id": "V1",
        "check": "all_files_present",
        "expect": "كل المسارات في install.order موجودة"
      },
      {
        "id": "V2",
        "check": "order_matches",
        "expect": "الترتيب 1..N مطابق تماماً للمسارات، بلا تقديم أو تأخير أو تكرار"
      },
      {
        "id": "V3",
        "check": "sha256_matches",
        "expect": "كل بصمة مطابقة عدا الملفات المعفاة صراحةً"
      },
      {
        "id": "V4",
        "check": "json_parse",
        "expect": "كل ملف .json صالح"
      },
      {
        "id": "V5",
        "check": "developer_signature_start_and_end",
        "expect": "توقيع يوسف الحمزي في بداية ونهاية كل ملف"
      },
      {
        "id": "V6",
        "check": "no_ddl",
        "expect": "لا عبارات DDL ولا جدول مستخدمين جديد"
      },
      {
        "id": "V7",
        "check": "single_unified_db",
        "expect": "الاتصال mother_panel.db.shared فقط، ولا جدول users محلي"
      },
      {
        "id": "V8",
        "check": "no_standalone_code",
        "expect": "لا PHP/JS ولا نقطة دخول ولا رمز ولا مفتاح داخل اللوحة"
      },
      {
        "id": "V9",
        "check": "mother_panel_refs_resolve",
        "expect": "كل مرجع mother_panel.* معرّف في sync.json"
      },
      {
        "id": "V10",
        "check": "icon_resolves",
        "expect": "app.json#/icon يشير إلى assets/icon.svg المثبّت"
      },
      {
        "id": "V11",
        "check": "install_scope_clean",
        "expect": "مجلد التثبيت يحوي ملفات الخريطة فقط، ولا مساراً خارج مجلد اللوحة"
      },
      {
        "id": "V12",
        "check": "internal_refs_resolve",
        "expect": "كل أقسام/قوالب/توثيق مشار إليه موجود في الخريطة"
      },
      {
        "id": "V13",
        "check": "tables_list_exact",
        "expect": "الجداول الـ24 الحالية مذكورة بالاسم وبلا إنشاء جداول"
      }
    ],
    "on_failure": "abort_and_rollback",
    "on_success": "mark_installed_and_report"
  },
