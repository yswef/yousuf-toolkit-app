  "app_id": "y-dimensions",
  "policy": {
    "database": "واحدة موحّدة تديرها لوحة الأم لكل تطبيقات المطوّر",
    "connection": "mother_panel.db.shared",
    "local_connection": null,
    "create_tables": false,
    "alter_tables": false,
    "duplicate_tables": false,
    "ddl_statements": [],
    "conflicts": "none",
    "inconsistencies": "none",
    "writes": "mother_panel_only",
    "transactions": "mother_panel_only",
    "timestamps": "BIGINT Unix UTC",
    "prepared_statements_only": true,
    "scope_of_every_query": "app_id = :app_id مع app_id = y-dimensions",
    "idempotency": "sync_log.request_id فريد لكل (app_id, action, request_id)",
    "unique_keys_enforced_by_mother_panel": [
      "users(app_id, email)",
      "board_licenses(app_id, license_key_hash)",
      "board_files(board_id, path)",
      "app_files(app_id, path)"
    ],
    "foreign_keys": "كل user_id يشير إلى users.id في الجدول الموحّد وتديره لوحة الأم"
  },
  "users_unified": {
    "name": "users",
    "status": "موحّد لكل تطبيقات المطوّر؛ موجود مسبقاً في قاعدة لوحة الأم",
    "created_by_this_board": false,
    "duplicate_users_table": false,
    "per_app_users_table": false,
    "variables_needed_by_this_app_only": {
      "id": "INT UNSIGNED",
      "app_id": "VARCHAR(64)",
      "email": "VARCHAR(190)",
      "password_hash": "VARCHAR(255)",
      "created_at": "BIGINT"
    },
    "account_separation": {
      "auto_propagate_to_other_apps": false,
      "new_account_per_app_required": true,
      "same_email_allowed_across_apps": true,
      "unique_key": [
        "app_id",
        "email"
      ],
      "note": "من يسجّل في Y- Dimensions لا يُنشأ له حساب تلقائياً في التطبيقات الأخرى؛ ينشئ حساباً جديداً في كل تطبيق بنفس البريد المسموح به"
    }
  },
  "blog_unified": {
    "single_blog": true,
    "per_app_blogs": false,
    "comment_blog_merged": true,
    "tables": [
      "posts",
      "board_comments",
      "board_stats"
    ],
    "content": "آراء وتقييمات العملاء عن التطبيقات",
    "scope": "app_id"
  },
